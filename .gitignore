# built binary (asciiscapes is the pre-2026-09-03 name; an old checkout
# still builds one, and it must not be committed either)
/xscapes
/asciiscapes

# generated frames — regenerable with `go run . -html=...`
# the PNG references are kept deliberately as a visual record
/assets/frames/*.html

# macOS
.DS_Store

# scratch build from the mirror branch
/as

# overlay mockups composite a capture of a real agent pane; never publish one
/assets/frames/overlay*.png
